<div class="apy-do-dont-grid">
{{#if do}}
<div class="apy-do">
<h4><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6.5 11.5L3 8l1-1 2.5 2.5L12 4l1 1z" fill="currentColor"/></svg>Do</h4>
<ul>
{{#each do}}<li>{{this}}</li>
{{/each}}
</ul>
</div>
{{/if}}
{{#if dont}}
<div class="apy-dont">
<h4><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5"/></svg>Don't</h4>
<ul>
{{#each dont}}<li>{{this}}</li>
{{/each}}
</ul>
</div>
{{/if}}
</div>
